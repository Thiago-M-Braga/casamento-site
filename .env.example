# ---------------------------------------------------------------------------
# Copie este arquivo para `.env.local` e preencha os valores.
# `.env.local` NUNCA deve ser commitado (já está no .gitignore).
# ---------------------------------------------------------------------------

# URL pública do site (usada em SEO, Open Graph, sitemap e retorno de pagamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard  →  Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave privada. Usada SOMENTE no servidor (Route Handlers). Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
# Opcional na primeira versão (que usa links de pagamento + PIX manual).
# ---------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Segredo de assinatura do webhook (Mercado Pago → Webhooks → Assinatura secreta)
MERCADOPAGO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Painel do casal — /adm/<codigo>
#
# Sem ADMIN_PASSWORD o painel fica desabilitado (é onde ficam nomes, telefones
# e comprovantes dos convidados). Use uma senha longa e aleatória.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=2329

# Opcional: troca o código da URL do painel sem editar o código-fonte.
# Padrão: o valor de weddingConfig.admin.secretPath (2329).
ADMIN_SECRET_PATH=
