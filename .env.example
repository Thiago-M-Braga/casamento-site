# ---------------------------------------------------------------------------
# Copie este arquivo para `.env.local` e preencha os valores.
# `.env.local` NUNCA deve ser commitado (já está no .gitignore).
# ---------------------------------------------------------------------------

# URL pública do site (usada em SEO, Open Graph, sitemap e retorno de pagamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard  →  Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave privada. Usada SOMENTE no servidor (Route Handlers). Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Pagamentos — PagBank
#
# Não há credencial a preencher aqui: o pagamento acontece por LINK.
# Cole o link de cada presente em config/gifts.ts → `paymentUrl`, e o link da
# contribuição livre em config/wedding.ts → `payments.pagbankLink`.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Painel do casal — /adm/<codigo>
#
# Sem ADMIN_PASSWORD o painel fica desabilitado (é onde ficam nomes, telefones
# e comprovantes dos convidados). Use uma senha longa e aleatória.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=

# Opcional: troca o código da URL do painel sem editar o código-fonte.
# Padrão: o valor de weddingConfig.admin.secretPath (2329).
ADMIN_SECRET_PATH=
